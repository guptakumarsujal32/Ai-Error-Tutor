# Environment Configuration for AI Error Tutor
# Copy this file to .env and fill in your Gemini API key.
# NEVER commit your real .env file to Git!

# Tier 1: Gemini API (Primary Cloud AI - get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30

# Tier 2: Local LLM via Ollama (Secondary Offline Fallback - https://ollama.com/)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_MODEL_FIXER=qwen2.5-coder:3b
OLLAMA_MODEL_DIAGNOSTICIAN=qwen2.5-coder:3b
OLLAMA_MODEL_TUTOR=qwen2.5-coder:3b
OLLAMA_MODEL_ATTACKER=qwen2.5-coder:3b
OLLAMA_MODEL_CRITIC=qwen2.5-coder:3b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=90

# Shared Inference, Circuit Breaker & Rate Limits
TEMPERATURE=0
NUM_CTX=4096
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN=60
RATE_LIMIT_RPM=15
